# Demos are large and contain player names / SteamIDs — never commit them
demos/
*.dem
*.dem.zip
*.dem.bz2
*.dem.gz
*.dem.zst

# The CS2 playback plugin (and any other native binary) is downloaded by the user, never committed
*.dll
*.so

# Env / editor
.env
.vscode/
.idea/
.claude/
