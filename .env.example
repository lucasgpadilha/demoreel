# Copy to .env and adjust. Every setting is optional.

# Where the database, demos, analyses and videos are stored.
DEMOREEL_DATA_DIR=data

# Bind address / port of `demoreel serve`.
DEMOREEL_HOST=127.0.0.1
DEMOREEL_PORT=8000

# Base URL used in links returned by the API and MCP tools (set it when behind a proxy / on a server).
# DEMOREEL_PUBLIC_URL=https://demoreel.example.com

# Require this key on /api and /mcp (Authorization: Bearer <key> or X-API-Key). Unset = open (local use).
# 16 characters at least; example values are refused. Make one with `openssl rand -hex 24`.
# DEMOREEL_API_KEY=

# Other names this server is reached by (a LAN address, a second domain). While no key is set, requests
# naming any other host are refused (DNS rebinding). localhost, DEMOREEL_HOST and the public URL's host count.
# DEMOREEL_ALLOWED_HOSTS=["192.168.0.10"]
# Other sites whose pages may call this API from the browser (with a key set, any site may still read).
# DEMOREEL_CORS_ORIGINS=["https://mixdavila.example"]
# Sites that may show the UI in an <iframe>, besides the brand kits' ui.embed.parents.
# DEMOREEL_FRAME_ANCESTORS=["https://mixdavila.example"]
# Largest JSON body a request may carry, in KB (uploads: DEMOREEL_MAX_UPLOAD_MB).
# DEMOREEL_MAX_JSON_KB=1024

# Worker processes started by `demoreel serve`.
DEMOREEL_WORKERS=1

# auto = in-game POV when this machine can record, else the 2D replay. Or: radar | ingame
DEMOREEL_DEFAULT_RENDERER=auto
# Render the N best highlights automatically after each analysis (0 = only on request).
DEMOREEL_AUTO_RENDER_TOP=3
DEMOREEL_RENDER_WIDTH=1280
DEMOREEL_RENDER_HEIGHT=720
DEMOREEL_RENDER_FPS=30

# Time zone used to group matches into nights (insights). Default: this machine's time zone.
# DEMOREEL_TIMEZONE=America/Sao_Paulo

# Brand kit (folder in <data dir>/brands) for the UI theme and the videos. Default: the only kit present.
# DEMOREEL_BRAND=mixdavila

# Allow this machine to record with the real CS2 client (see docs/ingame-recording.md).
# DEMOREEL_INGAME_ENABLED=1
# Auto-detected from Steam when unset:
# DEMOREEL_CS2_DIR=C:/Program Files (x86)/Steam/steamapps/common/Counter-Strike Global Offensive
# DEMOREEL_STEAM_EXE=C:/Program Files (x86)/Steam/steam.exe
# Folder holding the playback plugin binary (default: <data dir>/cache/csdm-plugin) and which build to use.
# DEMOREEL_INGAME_PLUGIN_DIR=
# DEMOREEL_INGAME_PLUGIN_VERSION=
# Hard limit for one recording session, in seconds (default: derived from the clip length).
# DEMOREEL_INGAME_TIMEOUT_S=
# Linux only: Steam Linux Runtime entry point, when it is not found automatically.
# DEMOREEL_INGAME_RUNTIME_SCRIPT=

# Folders the MCP tool `import_demo` may read demos from (JSON list).
# DEMOREEL_IMPORT_DIRS=["C:/demos"]

# Never download anything at runtime (radar images for the 2D renderer).
# DEMOREEL_OFFLINE=1

# Database. Default: SQLite inside the data dir. Postgres: pip install "demoreel[postgres]"
# DEMOREEL_DATABASE_URL=postgresql+psycopg://user:pass@host/demoreel

# Public viewer: when set, reading stays open but changing anything (POST/PATCH/DELETE on /api, and /mcp)
# needs this key. Set it before showing the UI to the public or embedding it in another site.
# 16 characters at least (`openssl rand -hex 24`).
# DEMOREEL_ADMIN_KEY=

# In-game recording backend: auto (HLAE where installed, else the game's own recorder) | startmovie | hlae.
# HLAE is Windows only and records in real time; extract a release to <data_dir>/cache/hlae/<version>/.
# DEMOREEL_INGAME_BACKEND=auto
# DEMOREEL_INGAME_HLAE_ENCODER=x264   # or nvenc on NVIDIA cards
# Minimum recording frame rate (30 = the output rate; 60 leaves room for slow-motion edits, costs ~30% more).
# DEMOREEL_INGAME_CAPTURE_FPS=30

# Weapon / kill-feed icons are read once from a local CS2 install into <data_dir>/cache/icons.
# Set to 0 to never read the game files (kill feeds then use text).
# DEMOREEL_ICONS_FROM_GAME=1
