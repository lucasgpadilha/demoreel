# demoreel mirror behind Caddy: videos straight from disk, everything else from the app.
#
# /etc/caddy/site.env (loaded by the caddy service):
#   SITE_ADDRESS     the public host name; Caddy then gets and renews the HTTPS certificate by itself.
#                    Empty = plain HTTP on port 80 (testing by IP).
#   FRAME_ANCESTORS  the sites allowed to embed the mirror in an <iframe>, space separated.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'self' {$FRAME_ANCESTORS}"
		-Server
	}

	# Finished videos and posters never change (a new render gets a new name).
	@videos path /files/renders/*
	handle @videos {
		uri strip_prefix /files
		root * /srv/demoreel/data
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
