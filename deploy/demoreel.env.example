DEMOREEL_DATA_DIR=/srv/demoreel/data
DEMOREEL_HOST=127.0.0.1
DEMOREEL_PORT=8000
DEMOREEL_WORKERS=0
# The address visitors use: video and poster links are built from it.
DEMOREEL_PUBLIC_URL=https://lances.example.com
# Anyone can watch; only requests carrying this key can change anything. `openssl rand -hex 24`
DEMOREEL_ADMIN_KEY=
# The brand kit (folder in <data>/brands) when more than one is published.
DEMOREEL_BRAND=
DEMOREEL_OFFLINE=1
DEMOREEL_AUTO_RENDER_TOP=0
DEMOREEL_INGAME_ENABLED=0
# Matches are grouped into nights in this time zone (the server's own is usually UTC).
DEMOREEL_TIMEZONE=America/Sao_Paulo
PYTHONUTF8=1
